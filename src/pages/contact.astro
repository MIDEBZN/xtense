---
import Layout from '../layouts/Layout.astro';

const emergencyPhone = "0464 78 05 73";
const emergencyPhoneRaw = "+32464780573";
const landline = "0464 78 05 73";
const landlineRaw = "+32464780573";
---

<Layout 
  title="Contactez xtense Plomberie à Tournai | Devis Gratuit & Urgence 24/7" 
  description="Contactez xtense Plomberie à Tournai (7500). Dépannage urgent 24h/7j au 0464 78 05 73 ou demande de devis gratuit pour travaux de plomberie et chauffage."
>
  <!-- Header -->
  <section class="section" style="padding-top: 4rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-subtle);">
    <div class="container text-center">
      <span class="badge-tag">Service Client & Dépannage Immédiat</span>
      <h1 class="section-title">Contactez xtense Plomberie Tournai</h1>
      <p class="section-subtitle" style="max-width: 680px; margin: 0 auto;">
        Une question technique, un devis pour votre salle de bain ou une urgence plomberie immédiate ? Nos dépanneurs vous répondent 24h/24 et 7j/7.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Grid -->
  <section class="section">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 3.5rem;">
        
        <!-- Coordinates -->
        <div>
          <h2 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem; color: #ffffff;">Nos Coordonnées Directes</h2>
          
          <div style="background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-subtle); padding: 2rem; margin-bottom: 2rem;">
            <div style="margin-bottom: 1.5rem;">
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem;">
                🚨 Urgences 24h/24 & 7j/7 (Dépannage express Tournai)
              </span>
              <a href={`tel:${emergencyPhoneRaw}`} style="font-size: 1.5rem; font-weight: 800; color: #ef4444; display: block; text-decoration: none;">
                {emergencyPhone}
              </a>
            </div>

            <div style="margin-bottom: 1.5rem;">
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem;">
                📞 Téléphone & Devis chantiers
              </span>
              <a href={`tel:${landlineRaw}`} style="font-size: 1.25rem; font-weight: 700; color: #38bdf8; display: block; text-decoration: none;">
                {landline}
              </a>
            </div>

            <div style="margin-bottom: 1.5rem;">
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem;">
                ✉️ Adresse e-mail
              </span>
              <a href="mailto:contact@xtense.site" style="font-size: 1.1rem; color: var(--text-primary); text-decoration: none;">
                contact@xtense.site
              </a>
            </div>

            <div>
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem;">
                📍 Siège & Dépôt
              </span>
              <p style="color: var(--text-primary); margin: 0; font-size: 1rem; line-height: 1.5;">
                Rue Général Piron 234<br />
                7500 Tournai, Hainaut, Belgique
              </p>
            </div>
          </div>

          <div style="background: rgba(2, 132, 199, 0.1); border: 1px solid var(--border-accent); border-radius: var(--radius-md); padding: 1.5rem;">
            <div style="font-weight: 700; color: #38bdf8; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <span>🕒</span> Horaires d'intervention
            </div>
            <p style="color: var(--text-secondary); font-size: 0.95rem; margin: 0; line-height: 1.6;">
              <strong>Dépannage d'urgence :</strong> 24h/24, 7j/7, y compris dimanches et jours fériés.<br />
              <strong>Chantiers & Rénovation :</strong> Lundi au Vendredi de 8h00 à 18h30.
            </p>
          </div>
        </div>

        <!-- Contact & Quote Form -->
        <div class="quote-box">
          <h2 style="font-size: 1.6rem; font-weight: 800; margin-bottom: 0.5rem; color: #ffffff;">Demander un Devis Gratuit</h2>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 2rem;">
            Remplissez notre formulaire. Un conseiller xtense analyse votre demande et vous recontacte sous 30 minutes.
          </p>

          <form action="#" method="POST" onsubmit="event.preventDefault(); alert('Merci pour votre message ! Un technicien xtense va vous recontacter très rapidement.');">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="form-group">
                <label class="form-label" for="contact-name">Nom complet *</label>
                <input type="text" id="contact-name" name="name" class="form-control" placeholder="Jean Dupont" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="contact-phone">Téléphone *</label>
                <input type="tel" id="contact-phone" name="phone" class="form-control" placeholder="0464 78 05 73" required />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="form-group">
                <label class="form-label" for="contact-email">Email</label>
                <input type="email" id="contact-email" name="email" class="form-control" placeholder="jean.dupont@email.com" />
              </div>
              <div class="form-group">
                <label class="form-label" for="contact-locality">Localité / Code Postal *</label>
                <input type="text" id="contact-locality" name="locality" class="form-control" placeholder="Ex: 7500 Tournai" required />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contact-service">Type d'intervention</label>
              <select id="contact-service" name="service" class="form-control">
                <option value="debouchage">Débouchage canalisation / WC / évier</option>
                <option value="fuite">Recherche et réparation de fuite d'eau</option>
                <option value="chaudiere">Entretien ou dépannage chaudière (Gaz / Mazout)</option>
                <option value="sanitaire">Rénovation complète de salle de bain</option>
                <option value="boiler">Chauffe-eau / boiler électrique</option>
                <option value="autre">Autre demande spécifique</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="contact-message">Détaillez votre besoin</label>
              <textarea id="contact-message" name="message" class="form-control" rows="4" placeholder="Précisez le problème constaté, l'accès, le modèle d'appareil..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1.05rem;">
              Envoyer ma demande de devis gratuite
            </button>
            
            <p style="color: var(--text-muted); font-size: 0.8rem; text-align: center; margin-top: 1rem;">
              En soumettant ce formulaire, vous acceptez d'être recontacté dans le cadre de votre demande technique.
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>
